# En el VPS estos cuatro cambian y no son opcionales: con APP_DEBUG=true
# cualquier error muestra el stack trace, las variables de entorno y la
# consulta que falló a quien lo provoque.
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://<dominio>
#   SESSION_SECURE_COOKIE=true
#
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# La operación es peruana: de acá sale el día de calendario con el que se
# fechan facturas, bajas y la meta mensual (ver App\Services\RelojOperativo).
# El resto de la aplicación sigue calculando en UTC.
APP_BUSINESS_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=flotavehicular
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción va en true: sin esto la cookie de sesión viaja también por
# HTTP y basta una petición en claro para quedársela.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tracksolid / JIMI Open API (GPS flota)
# Región: open.10000track.com (global) | hk-open | eu-open | us-open .tracksolidpro.com/route/rest
TRACKSOLID_BASE_URL=https://us-open.tracksolidpro.com/route/rest
TRACKSOLID_APP_KEY=
TRACKSOLID_APP_SECRET=
TRACKSOLID_ACCOUNT=
TRACKSOLID_PASSWORD_MD5=
# TRACKSOLID_PASSWORD= # alternativa en texto plano (el cliente calcula el md5)

# WhatsApp que recibe el resumen de salidas del día y teléfono de oficina
# para el preaviso al conductor. Ambos opcionales.
TRANSPATY_WHATSAPP_OPERACIONES=
TRANSPATY_TELEFONO_OFICINA=

# WhatsApp de abastecimiento y de facturación, que reciben el aviso de
# cada unidad programada. Opcionales.
TRANSPATY_WHATSAPP_ABASTECIMIENTO=
TRANSPATY_WHATSAPP_FACTURACION=

# Servicio de WhatsApp (whatsapp/servidor.js). El token debe ser el mismo en su entorno.
WHATSAPP_SERVICIO_URL=http://127.0.0.1:3100
WHATSAPP_SERVICIO_TOKEN=
